# One file per broker account. Copy, fill in, keep out of git (accounts/*.env
# is ignored; only this example is tracked).
#
#   cp accounts/example.env accounts/ftmo.env
#   bash update.sh --account accounts/ftmo.env
#
# When these are set, every MetaTrader launch logs into THIS account instead of
# whatever the terminal last used. Unset, the terminal's saved session is used.
# The password only ever lands in a temporary run.ini inside the terminal
# folder, written before the launch and deleted after it.
MT5_SERVER=FTMO-Demo
MT5_LOGIN=12345678
MT5_PASSWORD=change-me
